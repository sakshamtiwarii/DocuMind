# No LLM API key here — each user supplies their own (OpenAI or Groq) from the frontend,
# sent per-request with /ask. Embeddings run locally via fastembed, no key needed.

# "development" keeps full error detail in /health; "production" reports connected/unreachable
# only, since that endpoint is public and DSN errors leak host and database names.
ENVIRONMENT=development

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local container needs no key. Qdrant Cloud requires QDRANT_API_KEY and an https:// URL.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
# QDRANT_API_KEY=

# Neon/managed Postgres needs ?sslmode=require appended.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex for hosts that can't be listed up front (e.g. Vercel preview deploys):
# CORS_ORIGIN_REGEX=^https://documind-.*\.vercel\.app$

# Uploads and abuse limits (the API is public and unauthenticated).
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=10
ASK_RATE_LIMIT=30

# Ingestion runs in a background task; if the process dies mid-run the row would sit on
# "processing" forever, so anything older than this is reported as failed.
PROCESSING_TIMEOUT_MINUTES=10

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

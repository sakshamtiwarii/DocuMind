# No LLM API key here — each user supplies their own (OpenAI or Groq) from the frontend,
# sent per-request with /ask. Embeddings run locally via fastembed, no key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

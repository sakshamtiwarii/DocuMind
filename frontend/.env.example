# Base URL of the DocuMind API.
#
# Vite inlines this at BUILD time, not runtime — changing it on the host requires a rebuild,
# and on Vercel that means a redeploy after editing the environment variable.
#
# Local:      http://localhost:8000
# Production: https://<your-render-service>.onrender.com   (must be https, or the browser
#             will block it as mixed content from a https:// frontend)
VITE_API_URL=http://localhost:8000
